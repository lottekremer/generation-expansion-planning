library(readr)
library(ggplot2)
library(dplyr)
library(tidyr)

inputs <- read.csv("C:/Users/kremerlaa/OneDrive - TNO/Documents/gep/generation-expansion-planning/case_studies/optimality/inputs/generation_availability.csv")
inputs <- inputs %>% filter(scenario == 1900, location == "NED", timestep == 12, technology != "WindOff") %>% pivot_wider(names_from = technology, values_from = availability)

inputs_centered <- read.csv("C:/Users/kremerlaa/OneDrive - TNO/Documents/gep/generation-expansion-planning/case_studies/optimality/inputs_centered/generation_availability.csv")
inputs_centered <- inputs_centered %>%
  mutate(period = time_step %/% 24 + 1,
         time_step = time_step %% 24) %>% filter(scenario == 1900, location == "NED", time_step == 12, technology != "WindOff") %>% pivot_wider(names_from = technology, values_from = availability)

inputs_uniform <- read.csv("C:/Users/kremerlaa/OneDrive - TNO/Documents/gep/generation-expansion-planning/case_studies/optimality/inputs_uniform/generation_availability.csv")
inputs_uniform <- inputs_uniform %>%
  mutate(period = time_step %/% 24 + 1,
         time_step = time_step %% 24) %>% filter(scenario == 1900, location == "NED", time_step == 12, technology != "WindOff")%>% pivot_wider(names_from = technology, values_from = availability)

inputs_closer <- read.csv("C:/Users/kremerlaa/OneDrive - TNO/Documents/gep/generation-expansion-planning/case_studies/optimality/inputs_closer/generation_availability.csv")
inputs_closer <- inputs_closer %>%
