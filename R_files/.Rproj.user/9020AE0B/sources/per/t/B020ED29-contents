ggplot(inputs, aes(x = SunPV, y = WindOn)) +
  geom_point(size = 2) +
  labs(x = "Wind Availability", y = "Solar Availability", 
       title = "Original values of Wind vs Solar Availability") +
  coord_cartesian(xlim = c(0, 1), ylim = c(0, 1)) +
  theme_minimal()

ggplot(inputs, aes(x = SunPV, y = WindOn)) +
  geom_point(size = 3, colour = "red") +
  geom_point(data = inputs_uniform, aes(x = SunPV, y = WindOn), size = 1, colour = "blue") +
  labs(x = "Wind Availability", y = "Solar Availability", 
       title = "Uniformly created values of Wind vs Solar Availability") +
  coord_cartesian(xlim = c(0, 1), ylim = c(0, 1)) +
