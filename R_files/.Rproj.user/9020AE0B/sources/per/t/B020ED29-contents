         time_step = time_step %% 24) %>% filter(scenario == 1900, location == "NED", time_step == 12, technology != "WindOff")%>% pivot_wider(names_from = technology, values_from = availability)

inputs_closest <- read.csv("C:/Users/kremerlaa/OneDrive - TNO/Documents/gep/generation-expansion-planning/case_studies/optimality/inputs_closest/generation_availability.csv")
inputs_closest <- inputs_closest %>%
